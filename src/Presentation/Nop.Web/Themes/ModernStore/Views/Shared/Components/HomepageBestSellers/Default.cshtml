@model IList<ProductOverviewModel>

@*Theme override of Views/Shared/Components/HomepageBestSellers/Default.cshtml —
  editorial section chrome around the shared product card.*@
@if (Model.Count > 0)
{
    <section class="product-grid bestsellers ms-sec at-section">
        <header class="at-section__head">
            <div>
                <p class="at-eyebrow"><span class="at-eyebrow__rule" aria-hidden="true"></span> Client favourites · 02</p>
                <h2 class="at-section__title">@T("Bestsellers")</h2>
            </div>
        </header>
        <div class="item-grid at-product-grid">
            @foreach (var item in Model)
            {
                <div class="item-box">
                    @await Html.PartialAsync("_ProductBox", item)
                </div>
            }
        </div>
    </section>
}
