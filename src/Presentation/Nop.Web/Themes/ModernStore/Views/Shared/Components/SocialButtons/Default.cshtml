@model SocialModel
@*Theme override of Views/Shared/Components/SocialButtons/Default.cshtml. Same
  configured destinations and same resource strings as the base view — only the
  visible text chip becomes a brand glyph with the localized name kept for screen
  readers. Everything is inline SVG, so no icon dependency or extra request. *@
<ul class="networks">
    @if (!string.IsNullOrEmpty(Model.FacebookLink))
    {
        <li class="facebook">
            <a href="@Model.FacebookLink" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M14.5 8.2H17V5h-2.9c-2.6 0-4.3 1.7-4.3 4.4V12H7v3.2h2.8V22h3.4v-6.8h2.5l.5-3.2h-3V9.7c0-1 .4-1.5 1.3-1.5Z" />
                </svg>
                <span class="sr-only">@T("Footer.FollowUs.Facebook")</span>
            </a>
        </li>
    }
    @if (!string.IsNullOrEmpty(Model.TwitterLink))
    {
        <li class="twitter">
            <a href="@Model.TwitterLink" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M17.8 3h2.9l-6.4 7.3L21.8 21h-5.9l-4.6-6-5.3 6H3.1l6.8-7.8L2.7 3h6l4.1 5.5L17.8 3Zm-1 16.2h1.6L7.8 4.7H6.1l10.7 14.5Z" />
                </svg>
                <span class="sr-only">@T("Footer.FollowUs.Twitter")</span>
            </a>
        </li>
    }
    @if (Model.NewsEnabled)
    {
        <li class="rss">
            <a href="@Url.RouteUrl(NopRouteNames.Standard.NEWS_RSS, new { languageId = Model.WorkingLanguageId })">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M5.5 18.5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM3 11.2v2.6a7.2 7.2 0 0 1 7.2 7.2h2.6c0-5.4-4.4-9.8-9.8-9.8ZM3 4.4V7c7.8 0 14.2 6.4 14.2 14.2H20C20 11.4 12.6 4.4 3 4.4Z" />
                </svg>
                <span class="sr-only">@T("Footer.FollowUs.RSS")</span>
            </a>
        </li>
    }
    @if (!string.IsNullOrEmpty(Model.YoutubeLink))
    {
        <li class="youtube">
            <a href="@Model.YoutubeLink" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M22.5 12s0-3.3-.43-4.9a2.7 2.7 0 0 0-1.9-1.9C18.5 4.8 12 4.8 12 4.8s-6.5 0-8.2.4a2.7 2.7 0 0 0-1.9 1.9C1.5 8.7 1.5 12 1.5 12s0 3.3.4 4.9a2.7 2.7 0 0 0 1.9 1.9c1.7.4 8.2.4 8.2.4s6.5 0 8.2-.4a2.7 2.7 0 0 0 1.9-1.9c.43-1.6.43-4.9.43-4.9ZM9.8 15.4V8.6l6 3.4-6 3.4Z" />
                </svg>
                <span class="sr-only">@T("Footer.FollowUs.Youtube")</span>
            </a>
        </li>
    }
    @if (!string.IsNullOrEmpty(Model.InstagramLink))
    {
        <li class="instagram">
            <a href="@Model.InstagramLink" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                    <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="4.8" />
                    <circle cx="12" cy="12" r="4.1" />
                    <circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none" />
                </svg>
                <span class="sr-only">@T("Footer.FollowUs.Instagram")</span>
            </a>
        </li>
    }
</ul>
