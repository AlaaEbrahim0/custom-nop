@model HeaderLinksModel
@using Nop.Core.Domain.Customers
@inject Nop.Core.IWebHelper webHelper

@* ModernStore override of Views/Shared/Components/HeaderLinks/Default.cshtml.

   Two reasons this exists. The base opens the mini cart with a handler delegated on
   `.header-upper` (base Default.cshtml:67-84) for hover and focus; ModernStore renders
   the flyout as a sibling of <header>, so those events never reach it and the mini cart
   could not be opened at all. And the base is a row of bare text links, which is the
   single most recognisable nopCommerce tell in the chrome.

   Contract kept verbatim: AjaxCart.init is still handed '.header-links .cart-qty',
   '.header-links .wishlist-qty' and '#flyout-cart', so those two count elements stay
   descendants of .header-links with their original classes, #topcartlink is preserved,
   and the server writes into .cart-qty with ShoppingCart.HeaderQuantity — which is the
   string "({0})", so the count element must hold nothing but that value.
   Routes, model bindings, the private-message alert and both widget zones are unchanged.*@
<div class="header-links">
    <ul>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderLinksBefore, additionalData = Model })
        @if (Model.IsAuthenticated)
        {
            <li>
                <a href="@Url.RouteUrl(NopRouteNames.General.CUSTOMER_INFO)" class="ms-hlink ms-hlink--account ms-hlink--icon ico-account">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 11a3.75 3.75 0 1 0 0-7.5A3.75 3.75 0 0 0 12 11Zm-7.5 9.75a7.5 7.5 0 0 1 15 0" />
                    </svg>
                    <span class="ms-hlink__label">@T("Account.MyAccount")</span>
                </a>
            </li>
            <li>
                <a href="@Url.RouteUrl(NopRouteNames.Standard.LOGOUT)" class="ms-hlink ms-hlink--quiet ico-logout">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9 18.75 12l-3 3m3-3H9.75m-3 6.75H6a2.25 2.25 0 0 1-2.25-2.25V6.75A2.25 2.25 0 0 1 6 4.5h.75" />
                    </svg>
                    <span class="ms-hlink__label">@T("Account.Logout")</span>
                </a>
            </li>
        }
        else
        {
            var returnUrl = Context.Request.Query.TryGetValue("returnUrl", out var url) && !StringValues.IsNullOrEmpty(url)
                ? url.ToString()
                : webHelper.GetRawUrl(Context.Request);

            @if (Model.RegistrationType != UserRegistrationType.Disabled)
            {
                <li>
                    <a href="@Url.RouteUrl(NopRouteNames.Standard.REGISTER, new { returnUrl })" class="ms-hlink ms-hlink--quiet ico-register">
                        <span class="ms-hlink__label">@T("Account.Register")</span>
                    </a>
                </li>
            }
            <li>
                <a href="@Url.RouteUrl(NopRouteNames.General.LOGIN, new { returnUrl })" class="ms-hlink ms-hlink--account ms-hlink--icon ico-login">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 11a3.75 3.75 0 1 0 0-7.5A3.75 3.75 0 0 0 12 11Zm-7.5 9.75a7.5 7.5 0 0 1 15 0" />
                    </svg>
                    <span class="ms-hlink__label">@T("Account.Login")</span>
                </a>
            </li>
        }
        @if (Model.AllowPrivateMessages)
        {
            <li>
                <a href="@Url.RouteUrl(NopRouteNames.Standard.PRIVATE_MESSAGES, new { tab = "" })" class="ms-hlink ms-hlink--icon ico-inbox">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5a.75.75 0 0 1 .75.75v9a.75.75 0 0 1-.75.75H3.75a.75.75 0 0 1-.75-.75v-9a.75.75 0 0 1 .75-.75Zm16.5.75L12 13.5 3.75 7.5" />
                    </svg>
                    <span class="ms-hlink__label inbox-label">@T("PrivateMessages.Inbox")</span>
                    <span class="ms-hlink__count inbox-unread">@Model.UnreadPrivateMessages</span>
                </a>
            </li>
        }
        @if (Model.WishlistEnabled)
        {
            <li>
                <a href="@Url.RouteUrl(NopRouteNames.General.WISHLIST)" class="ms-hlink ms-hlink--icon ico-wishlist">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25 4.9 13.2A4.5 4.5 0 0 1 11.25 6.3l.75.7.75-.7a4.5 4.5 0 0 1 6.35 6.9Z" />
                    </svg>
                    <span class="ms-hlink__label wishlist-label">@T("Wishlist")</span>
                    <span class="ms-hlink__count wishlist-qty">@T("Wishlist.HeaderQuantity", Model.WishlistItems)</span>
                </a>
            </li>
        }
        @if (Model.ShoppingCartEnabled)
        {
            <li id="topcartlink">
                @* Real link to /cart: theme.js only intercepts unmodified left clicks, so
                   ctrl/middle click and no-JavaScript navigation still reach the cart page. *@
                <a href="@Url.RouteUrl(NopRouteNames.General.CART)" class="ms-hlink ms-hlink--cart ms-hlink--icon ico-cart" data-ms-drawer-toggle aria-controls="flyout-cart" aria-expanded="false">
                    <svg class="ms-hlink__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 5h1.9l2.2 9.6a1.9 1.9 0 0 0 1.86 1.47h7.4a1.9 1.9 0 0 0 1.86-1.47L21.5 8H6.6m3.9 12.5a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2Zm7 0a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2Z" />
                    </svg>
                    <span class="ms-hlink__label cart-label">@T(NopRouteNames.General.CART)</span>
                    <span class="ms-hlink__count cart-qty">@T("ShoppingCart.HeaderQuantity", Model.ShoppingCartItems)</span>
                </a>
            </li>
        }
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderLinksAfter, additionalData = Model })
    </ul>
    @if (Model.AllowPrivateMessages && !string.IsNullOrEmpty(Model.AlertMessage))
    {
        //new private message notification
        <script asp-location="Footer">
            $(function() {
                displayPopupNotification('@Html.Raw(JavaScriptEncoder.Default.Encode(Model.AlertMessage))', 'success', false);
            });
        </script>
    }
    @if (Model.ShoppingCartEnabled)
    {
        <script asp-location="Footer">
            $(function() {
                var localized_data = {
                    AjaxCartFailure: "@T("AjaxCart.Failure")"
                };

                AjaxCart.init(@Model.UsePopupNotifications.ToString().ToLowerInvariant(), '.header-links .cart-qty', '.header-links .wishlist-qty', '#flyout-cart', localized_data);
            });
        </script>
    }
</div>
