@model CustomerNavigationModel

@* ModernStore override of Views/Shared/Components/CustomerNavigation/Default.cshtml.
   This is the account sidebar the brief calls "AccountMenu": the component is
   CustomerNavigationViewComponent, so the view folder must be CustomerNavigation.

   One DOM serves both layouts. From 1024px up the sheet chrome is inert — the panel
   is display:contents, so the rail is exactly a titled list as before. Below it the
   section is pulled out of the rail and becomes a bottom sheet (the same controller
   and the same shape as the catalog filter sheet in _CatalogFilters.cshtml), opened
   by the trigger above it: a horizontal chip rail overflowed its own pills on a
   phone, and 14 account destinations do not scan in a scroller.

   Must not drift: Model.SelectedTab still decides the state, and each <li> keeps
   @item.ItemClass plus the active/inactive class verbatim, because that is how the
   base marks the current page. Both widget zones stay inside <ul class="list">,
   before and after the item loop, in the same order. Routes come from item.RouteName
   and titles from item.Title — no new locale key was used. *@
@{
    //Keyed on CustomerNavigationItemModel.ItemClass, which the model factory sets per surface.
    var iconPaths = new Dictionary<string, string>
    {
        ["customer-info"] = "M12 11a3.75 3.75 0 1 0 0-7.5A3.75 3.75 0 0 0 12 11Zm-7.5 9.75a7.5 7.5 0 0 1 15 0",
        ["customer-addresses"] = "M12 21s6.75-5.1 6.75-10.5a6.75 6.75 0 1 0-13.5 0C5.25 15.9 12 21 12 21Zm0-8.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z",
        ["customer-orders"] = "M6.75 4.5h10.5v15.75l-3.5-2.25-1.75 1.125-1.75-1.125-3.5 2.25V4.5Zm3 5.25h4.5m-4.5 3.75h3",
        ["customer-recurring-payments"] = "M17 6.5 20 9.5 17 12.5M20 9.5H7M7 11.5 4 14.5 7 17.5M4 14.5h13",
        ["return-requests"] = "M4.5 9.5A7.5 7.5 0 1 1 12 17M4.5 9.5V4.5M4.5 9.5h5",
        ["downloadable-products"] = "M12 4.5v10m0 0 3.5-3.5M12 14.5l-3.5-3.5M5.5 19.5h13",
        ["back-in-stock-subscriptions"] = "M6 16.5c1-1 1.5-2 1.5-4.5a4.5 4.5 0 0 1 9 0c0 2.5.5 3.5 1.5 4.5H6Zm4.5 2a3 3 0 0 0 3 0M12 6.5V5",
        ["reward-points"] = "m12 4.5 2.35 4.76 5.25.76-3.8 3.7.9 5.23L12 16.73 7.3 18.95l.9-5.23-3.8-3.7 5.25-.76L12 4.5Z",
        ["change-password"] = "M8 10.5V8a4 4 0 0 1 8 0v2.5M6.5 10.5h11a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19v-7a1.5 1.5 0 0 1 1.5-1.5Z",
        ["customer-avatar"] = "M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Zm0-8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-4.25 4.9a5 5 0 0 1 8.5 0",
        ["forum-subscriptions"] = "M5 6.5h14a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-.5.5h-8L6 19.5v-4H5a.5.5 0 0 1-.5-.5V7a.5.5 0 0 1 .5-.5Z",
        ["customer-reviews"] = "M4.5 19.5l3.5-.75L19 8.25a2.12 2.12 0 0 0-3-3L5 15.75l-.5 3.75Z",
        ["customer-vendor-info"] = "M4 9.5h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9Zm0 0L6 4.5h12l2 5M9.5 13.5h5",
        ["customer-gdpr"] = "M12 4.5 5.5 7v5c0 3.75 2.75 6.5 6.5 7.5 3.75-1 6.5-3.75 6.5-7.5V7L12 4.5Z",
        ["customer-check-gift-card-balance"] = "M4 8.5h16v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 16.5v-8Zm0 0V8a1.5 1.5 0 0 1 1.5-1.5h13A1.5 1.5 0 0 1 20 8v.5M7.5 12h3",
        ["customer-multiFactor-authentication"] = "M8 4.5h8a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1Zm2.5 8.5 1.5 1.5 3-3"
    };
    var fallbackPath = "M12 13.25a1.25 1.25 0 1 0 0-2.5 1.25 1.25 0 0 0 0 2.5Z";
}

@* Mobile entry point to the sheet; hidden from 1024px up, where the rail is visible. *@
<button type="button" class="at-nav-trigger" data-ms-drawer-toggle aria-controls="account-nav-panel" aria-expanded="false">
    <svg class="at-nav-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" d="M4 6.5h16M4 12h16M4 17.5h16" />
    </svg>
    <span class="at-nav-trigger__label">@T("Account.Navigation")</span>
    <svg class="at-nav-trigger__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="m6 9.5 6 6 6-6" />
    </svg>
</button>

<section class="block block-account-navigation ms-nav-block at-nav-sheet" id="account-nav-panel" tabindex="-1" aria-labelledby="account-nav-title">
    <div class="at-nav-sheet__backdrop" data-ms-drawer-close aria-hidden="true"></div>
    <div class="at-nav-sheet__panel">
        <header class="at-nav-sheet__head">
            <h2 class="title ms-nav__heading at-nav-sheet__title" id="account-nav-title">
                @T("Account.Navigation")
            </h2>
            <button type="button" class="at-nav-sheet__close" data-ms-drawer-close>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" />
                </svg>
                <span class="sr-only">@T("Common.Close")</span>
            </button>
        </header>
        <div class="at-nav-sheet__body">
            <nav class="ms-nav" aria-labelledby="account-nav-title">
                <div class="listbox">
                    <ul class="list ms-nav__list">
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationBefore, additionalData = Model })
                        @foreach (var item in Model.CustomerNavigationItems)
                        {
                            var isActive = Model.SelectedTab == item.Tab;
                            var icon = iconPaths.TryGetValue(item.ItemClass ?? string.Empty, out var path) ? path : fallbackPath;
                            <li class="@item.ItemClass @(isActive ? "active" : "inactive") ms-nav__item">
                                <a href="@Url.RouteUrl(item.RouteName)" class="ms-nav__link" aria-current="@(isActive ? "page" : "false")">
                                    <svg class="ms-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="@icon" />
                                    </svg>
                                    <span class="ms-nav__label">@(item.Title)</span>
                                </a>
                            </li>
                        }
                        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationAfter, additionalData = Model })
                    </ul>
                </div>
            </nav>
        </div>
    </div>
</section>
