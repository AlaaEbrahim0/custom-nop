@model RegisterModel
@using Nop.Core

@* ModernStore override of Views/Customer/Register.cshtml.

   The register surface mirrors the sign-in entrance: an editorial panel carrying the
   wordmark and client notes, and a form panel where the long registration form is
   grouped into numbered, in-flow sections (numbering is CSS-generated, so conditional
   sections never leave a gap). The last section carries the legal consents, then the
   single submit.

   Must not drift: the scripts below are the base view's and bind #register-button (the
   submit button, which must keep that id AND name), #accept-consent, #consent{Id} and
   #read-privacyinfo. Every asp-for, asp-validation-for, name/id, the <div asp-validation-summary>,
   the CountryId select's data-trigger/data-url/data-stateprovince/data-loading (public.countryselect.js),
   #states-loading-progress, the _CheckUsernameAvailability partial (it binds #Username),
   the honeypot and <nop-captcha />, the RegisterTop/RegisterBottom widget zones, the
   ExternalAuthentication component and the form's asp-route/asp-route-returnurl are
   unchanged. No locale key was added or edited. *@

@inject IWebHelper webHelper

@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Register").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-registration-page");

    var loginUrl = Url.RouteUrl(NopRouteNames.General.LOGIN, new { returnUrl = Context.Request.Query["ReturnUrl"] }, webHelper.GetCurrentRequestProtocol());
}

<div class="page registration-page ms-reg at-auth at-reg">
    <div class="at-auth__layout">
        <aside class="at-auth__intro at-reg__intro">
            @* Brand wordmark via the shared LogoViewComponent — see Login.cshtml. *@
            @await Component.InvokeAsync(typeof(LogoViewComponent))

            <div class="at-auth__intro-copy">
                <p class="at-eyebrow"><span class="at-eyebrow__rule" aria-hidden="true"></span> New accounts</p>
                <p class="at-auth__intro-title">An account,<br /><em>quietly kept.</em></p>
                <p class="at-auth__intro-text">
                    Register once and the atelier remembers: the objects you set aside,
                    the addresses you use and everything you have already chosen.
                </p>
            </div>

            <ul class="at-auth__notes">
                <li><span>01</span> Private lists that keep your selections</li>
                <li><span>02</span> Order history and dispatch notices</li>
                <li><span>03</span> Saved addresses for faster checkout</li>
            </ul>

            <div class="at-auth__switch">
                <span>Already a client?</span>
                <a href="@loginUrl">@T("Account.Login")</a>
            </div>

            <a class="at-auth__back" href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">
                <span aria-hidden="true">←</span> Return to the atelier
            </a>
        </aside>

        <div class="at-auth__main at-reg__main">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.RegisterTop, additionalData = Model })
            <div class="page-body ms-reg__body at-auth__body">
                <header class="at-auth__head">
                    <p class="at-eyebrow"><span class="at-eyebrow__rule" aria-hidden="true"></span> Client registration</p>
                    <h1>@T("Account.Register")</h1>
                </header>

                <form asp-route="@NopRouteNames.Standard.REGISTER" asp-route-returnurl="@Context.Request.Query["ReturnUrl"]" method="post" autocomplete="off" class="ms-reg-form at-reg__form">
                    <div asp-validation-summary="ModelOnly" class="message-error"></div>
                    <fieldset class="fieldset ms-form-section ms-form-section--primary at-reg__section">
                        <legend class="title ms-form-section__legend at-reg__legend">
                            @T("Account.YourPersonalDetails")
                        </legend>
                        <div class="form-fields ms-field-grid">
                            @if (Model.GenderEnabled)
                            {
                                <div class="inputs ms-field ms-field--full">
                                    <label for="gender" class="ms-field__label">@T("Account.Fields.Gender"):</label>
                                    <div id="gender" class="gender ms-radio-row">
                                        <span class="male ms-radio">
                                            <input type="radio" asp-for="Gender" value="M" checked="@(Model.Gender == "M")" id="gender-male" class="ms-radio__input" />
                                            <label class="forcheckbox ms-radio__label" for="gender-male">@T("Account.Fields.Gender.Male")</label>
                                        </span>
                                        <span class="female ms-radio">
                                            <input type="radio" asp-for="Gender" value="F" checked="@(Model.Gender == "F")" id="gender-female" class="ms-radio__input" />
                                            <label class="forcheckbox ms-radio__label" for="gender-female">@T("Account.Fields.Gender.Female")</label>
                                        </span>
                                        @if (Model.NeutralGenderEnabled)
                                        {
                                            <span class="Neutral ms-radio">
                                                <input type="radio" asp-for="Gender" value="N" checked="@(Model.Gender == "N")" id="gender-neutral" class="ms-radio__input" />
                                                <label class="forcheckbox ms-radio__label" for="gender-neutral">@T("Account.Fields.Gender.Neutral")</label>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Model.FirstNameEnabled)
                            {
                                <div class="inputs ms-field">
                                    <label asp-for="FirstName" asp-postfix=":" class="ms-field__label"></label>
                                    <input asp-for="FirstName" class="ms-field__input" />
                                    @if (Model.FirstNameRequired)
                                    {
                                        <nop-required />
                                    }
                                    <span asp-validation-for="FirstName" class="ms-field__error"></span>
                                </div>
                            }
                            @if (Model.LastNameEnabled)
                            {
                                <div class="inputs ms-field">
                                    <label asp-for="LastName" asp-postfix=":" class="ms-field__label"></label>
                                    <input asp-for="LastName" class="ms-field__input" />
                                    @if (Model.LastNameRequired)
                                    {
                                        <nop-required />
                                    }
                                    <span asp-validation-for="LastName" class="ms-field__error"></span>
                                </div>
                            }
                            @if (Model.DateOfBirthEnabled)
                            {
                                <div class="inputs date-of-birth ms-field ms-field--full">
                                    <label class="ms-field__label">@T("Account.Fields.DateOfBirth"):</label>
                                    <nop-date-picker asp-day-name="@Html.NameFor(x => x.DateOfBirthDay)"
                                                     asp-month-name="@Html.NameFor(x => x.DateOfBirthMonth)"
                                                     asp-year-name="@Html.NameFor(x => x.DateOfBirthYear)"
                                                     asp-begin-year="@(DateTime.Now.AddYears(-110))"
                                                     asp-end-year="@(DateTime.UtcNow)"
                                                     asp-selected-date="@Model.ParseDateOfBirth()" />

                                    @if (Model.DateOfBirthRequired)
                                    {
                                        <nop-required />
                                    }
                                    <span asp-validation-for="DateOfBirthDay" class="ms-field__error"></span>
                                    <span asp-validation-for="DateOfBirthMonth" class="ms-field__error"></span>
                                    <span asp-validation-for="DateOfBirthYear" class="ms-field__error"></span>
                                </div>
                            }
                            <div class="inputs ms-field ms-field--full">
                                <label asp-for="Email" asp-postfix=":" class="ms-field__label"></label>
                                <input asp-for="Email" class="ms-field__input" />
                                <nop-required />
                                <span asp-validation-for="Email" class="ms-field__error"></span>
                            </div>
                            @if (Model.EnteringEmailTwice)
                            {
                                <div class="inputs ms-field ms-field--full">
                                    <label asp-for="ConfirmEmail" asp-postfix=":" class="ms-field__label"></label>
                                    <input asp-for="ConfirmEmail" class="ms-field__input" />
                                    <nop-required />
                                    <span asp-validation-for="ConfirmEmail" class="ms-field__error"></span>
                                </div>
                            }
                            @if (Model.UsernamesEnabled)
                            {
                                <div class="inputs ms-field">
                                    <label asp-for="Username" asp-postfix=":" class="ms-field__label"></label>
                                    <input asp-for="Username" class="ms-field__input" />
                                    <nop-required />
                                    <span asp-validation-for="Username" class="ms-field__error"></span>
                                    @if (Model.CheckUsernameAvailabilityEnabled)
                                    {
                                        @await Html.PartialAsync("_CheckUsernameAvailability")
                                    }
                                </div>
                            }
                        </div>
                    </fieldset>
                    @if (Model.CompanyEnabled || Model.DisplayVatNumber)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--optional at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.CompanyDetails")
                            </legend>
                            <div class="form-fields ms-field-grid">
                                @if (Model.CompanyEnabled)
                                {
                                    <div class="inputs ms-field ms-field--full">
                                        <label asp-for="Company" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="Company" class="ms-field__input" />
                                        @if (Model.CompanyRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="Company" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.DisplayVatNumber)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="VatNumber" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="VatNumber" class="ms-field__input" />
                                        @if (Model.VatNumberRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="VatNumber" class="ms-field__error"></span>
                                        <span class="vat-note ms-field__note"><em>@T("Account.Fields.VatNumber.Note")</em></span>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    @if (Model.StreetAddressEnabled ||
                        Model.StreetAddress2Enabled ||
                        Model.ZipPostalCodeEnabled ||
                        Model.CityEnabled ||
                        Model.CountyEnabled ||
                        Model.CountryEnabled)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--address at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.YourAddress")
                            </legend>
                            <div class="form-fields ms-field-grid">
                                @if (Model.StreetAddressEnabled)
                                {
                                    <div class="inputs ms-field ms-field--full">
                                        <label asp-for="StreetAddress" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="StreetAddress" class="ms-field__input" />
                                        @if (Model.StreetAddressRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="StreetAddress" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.StreetAddress2Enabled)
                                {
                                    <div class="inputs ms-field ms-field--full">
                                        <label asp-for="StreetAddress2" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="StreetAddress2" class="ms-field__input" />
                                        @if (Model.StreetAddress2Required)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="StreetAddress2" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.ZipPostalCodeEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="ZipPostalCode" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="ZipPostalCode" class="ms-field__input" />
                                        @if (Model.ZipPostalCodeRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="ZipPostalCode" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.CountyEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="County" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="County" class="ms-field__input" />
                                        @if (Model.CountyRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="County" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.CityEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="City" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="City" class="ms-field__input" />
                                        @if (Model.CityRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="City" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.CountryEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="CountryId" asp-postfix=":" class="ms-field__label"></label>
                                        <select asp-for="CountryId" asp-items="Model.AvailableCountries" class="ms-field__input"
                                                data-trigger="country-select"
                                                data-url="@(Url.RouteUrl(NopRouteNames.Ajax.GET_STATES_BY_COUNTRY_ID))"
                                                data-stateprovince="#@Html.IdFor(model => model.StateProvinceId)"
                                                data-loading="#states-loading-progress"></select>
                                        @if (Model.CountryRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="CountryId" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.CountryEnabled && Model.StateProvinceEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="StateProvinceId" asp-postfix=":" class="ms-field__label"></label>
                                        <select asp-for="StateProvinceId" asp-items="Model.AvailableStates" class="ms-field__input"></select>
                                        @if (Model.StateProvinceRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span id="states-loading-progress" style="display: none;" class="please-wait">@T("Common.Wait")</span>
                                        <span asp-validation-for="StateProvinceId" class="ms-field__error"></span>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    @if (Model.PhoneEnabled || Model.FaxEnabled)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--optional at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.YourContactInformation")
                            </legend>
                            <div class="form-fields ms-field-grid">
                                @if (Model.PhoneEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="Phone" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="Phone" class="ms-field__input" />
                                        @if (Model.PhoneRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="Phone" class="ms-field__error"></span>
                                    </div>
                                }
                                @if (Model.FaxEnabled)
                                {
                                    <div class="inputs ms-field">
                                        <label asp-for="Fax" asp-postfix=":" class="ms-field__label"></label>
                                        <input asp-for="Fax" class="ms-field__input" />
                                        @if (Model.FaxRequired)
                                        {
                                            <nop-required />
                                        }
                                        <span asp-validation-for="Fax" class="ms-field__error"></span>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    @if (Model.NewsletterEnabled && Model.NewsLetterSubscriptions.Count > 0)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--optional at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.SubscribeToNewsletter")
                            </legend>
                            <div class="form-fields ms-field-grid">
                                <div class="inputs ms-field ms-field--full">
                                    <div class="attributes ms-choice-list">
                                        <ul class="ms-choice-list__items">
                                            @for (int i = 0; i < Model.NewsLetterSubscriptions.Count; i++)
                                            {
                                                <li class="ms-choice">
                                                    <label asp-for="NewsLetterSubscriptions[i].IsActive" class="ms-choice__label">@Model.NewsLetterSubscriptions[i].Name</label>
                                                    <input type="hidden" asp-for="NewsLetterSubscriptions[i].TypeId" />
                                                    <input class="form-check-input ms-choice__input" type="checkbox" asp-for="NewsLetterSubscriptions[i].IsActive" />
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    }
                    @if (Model.CustomerAttributes.Count > 0)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--optional at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.Options")
                            </legend>
                            <div class="form-fields">
                                @await Html.PartialAsync("_CustomerAttributes", Model.CustomerAttributes)
                            </div>
                        </fieldset>
                    }
                    @if (Model.AllowCustomersToSetTimeZone)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--optional at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.Preferences")
                            </legend>
                            <div class="form-fields ms-field-grid">
                                <div class="inputs ms-field">
                                    <label asp-for="TimeZoneId" asp-postfix=":" class="ms-field__label"></label>
                                    <select asp-for="TimeZoneId" asp-items="Model.AvailableTimeZones" class="ms-field__input"></select>
                                    <span asp-validation-for="TimeZoneId" class="ms-field__error"></span>
                                </div>
                            </div>
                        </fieldset>
                    }
                    <fieldset class="fieldset ms-form-section ms-form-section--password at-reg__section">
                        <legend class="title ms-form-section__legend at-reg__legend">
                            @T("Account.YourPassword")
                        </legend>
                        <div class="form-fields ms-field-grid">
                            <div class="inputs ms-field">
                                <label asp-for="Password" asp-postfix=":" class="ms-field__label"></label>
                                <input asp-for="Password" class="ms-field__input" />
                                <nop-required />
                                <span asp-validation-for="Password" class="ms-field__error"></span>
                            </div>
                            <div class="inputs ms-field">
                                <label asp-for="ConfirmPassword" asp-postfix=":" class="ms-field__label"></label>
                                <input asp-for="ConfirmPassword" class="ms-field__input" />
                                <nop-required />
                                <span asp-validation-for="ConfirmPassword" class="ms-field__error"></span>
                            </div>
                            @if (Model.DisplayCaptcha)
                            {
                                <nop-captcha />
                            }
                            @if (Model.HoneypotEnabled)
                            {
                                @Html.Raw(Html.GenerateHoneypotInput())
                            }
                        </div>
                    </fieldset>

                    @if (Model.AcceptPrivacyPolicyEnabled || Model.GdprConsents.Count > 0)
                    {
                        <fieldset class="fieldset ms-form-section ms-form-section--legal at-reg__section">
                            <legend class="title ms-form-section__legend at-reg__legend">
                                @T("Account.UserAgreement")
                            </legend>
                            <div class="form-fields ms-consent-group">
                                @if (Model.AcceptPrivacyPolicyEnabled)
                                {
                                    <script asp-location="Footer">
                                        $(function() {
                                            $('#register-button').on('click', function() {
                                                if ($('#accept-consent').is(':checked')) {
                                                    //do some stuff
                                                    return true;
                                                } else {
                                                    //just show validation errors, don't post
                                                    alert('@Html.Raw(JavaScriptEncoder.Default.Encode(T("Account.Fields.AcceptPrivacyPolicy.Required").Text))');
                                                    return false;
                                                }
                                            });
                                        });
                                    </script>
                                    <div class="inputs accept-consent ms-consent">
                                        <input id="accept-consent" type="checkbox" name="accept-consent" class="ms-consent__input" />
                                        <label for="accept-consent" class="ms-consent__label">@T("Account.Fields.AcceptPrivacyPolicy")</label>
                                        @if (Model.AcceptPrivacyPolicyPopup)
                                        {
                                            <span class="read ms-consent__read" id="read-privacyinfo">@T("Account.Fields.AcceptPrivacyPolicy.Read")</span>
                                            <script asp-location="Footer">
                                            $(function() {
                                                $('#read-privacyinfo').on('click',
                                                    function(e) {
                                                        displayPopupContentFromUrl(
                                                                '@Url.RouteUrl(NopRouteNames.Ajax.TOPIC_POPUP, new { SystemName = "privacyinfo" })',
                                                            '@T("Account.Fields.AcceptPrivacyPolicy")');
                                                    });
                                            });
                                            </script>
                                        }
                                        else
                                        {
                                            <a class="read ms-consent__read" id="read-privacyinfo" href="@await NopUrl.RouteTopicUrlAsync("privacyinfo")">@T("Account.Fields.AcceptPrivacyPolicy.Read")</a>
                                        }
                                    </div>
                                }

                                @if (Model.GdprConsents.Count > 0)
                                {
                                    foreach (var consent in Model.GdprConsents)
                                    {
                                        if (consent.IsRequired)
                                        {
                                            <script asp-location="Footer">
                                            $(function() {
                                                $('#register-button').on('click', function() {
                                                    if ($('#consent@(consent.Id)').is(':checked')) {
                                                            //do some stuff
                                                            return true;
                                                        } else {
                                                            //just show validation errors, don't post
                                                       alert('@Html.Raw(JavaScriptEncoder.Default.Encode(consent.RequiredMessage))');
                                                        return false;
                                                        }
                                                    });
                                            });
                                            </script>
                                        }
                                        <div class="inputs accept-consent ms-consent">
                                            <input id="consent@(consent.Id)" type="checkbox" name="consent@(consent.Id)" checked="@consent.Accepted" class="ms-consent__input" />
                                            <label for="consent@(consent.Id)" class="ms-consent__label">@consent.Message</label>
                                        </div>
                                    }

                                }
                            </div>
                        </fieldset>
                    }

                    <section class="buttons ms-form-actions at-reg__actions">
                        <button type="submit" name="register-button" id="register-button" class="button-1 register-next-step-button ms-form-submit at-btn">@T("Account.Register.Button")</button>
                    </section>
                </form>
                <div class="external-authentication ms-auth-social at-auth__social">
                    @await Component.InvokeAsync(typeof(ExternalMethodsViewComponent), "ExternalAuthentication")
                </div>
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.RegisterBottom, additionalData = Model })
            </div>
        </div>
    </div>
</div>
